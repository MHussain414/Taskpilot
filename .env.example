# Copy to .env and adjust as needed
FLASK_SECRET_KEY=change-me-to-a-random-secret
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Optional: OpenAI for enhanced chat (leave empty for built-in AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: restrict login (leave empty = any email/password works for demo)
DEMO_EMAIL=manager@company.com
DEMO_PASSWORD=
